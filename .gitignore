# ── Node Modules (never push these) ──────────
node_modules/
client/node_modules/
server/node_modules/

# ── Environment Variables (keep secret) ──────
.env
server/.env
client/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# ── React Build Output ────────────────────────
client/build/
build/

# ── Uploaded Files ────────────────────────────
server/uploads/*
!server/uploads/.gitkeep

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS Files ─────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# ── VS Code Settings ──────────────────────────
.vscode/
*.code-workspace

# ── Coverage & Testing ────────────────────────
coverage/
.nyc_output

# ── Misc ──────────────────────────────────────
*.zip
*.tar.gz
.cache/
dist/